{
  "name": "2dfireengine",
  "version": "1.0.0",
  "description": "2D Game Engine",
  "exports": "./src/engine/index.js",
  "type": "module",
  "scripts": {
    "babel": "babel --presets es2015 js/main.js -o build/main.bundle.js",
    "start": "node server.js",
    "dev-start": "nodemon server.js",
    "dist-start": "node ../../dist/server.js",
    "dev-start2": "nodemon --es-module-specifier-resolution=node src/server/index.js",
    "dev-server": "webpack-dev-server --open --config webpack.dev.js --history-api-fallback --inline --progress",
    "dev": "npm-run-all --parallel dev-server dev-start",
    "build": "webpack --config webpack.dev.js",
    "test": "jest",
    "build-engine": "webpack --config webpack.build-engine.cjs",
    "build-game": "npm-run-all --parallel dev-start2 build-game-dev",
    "build-game-dev": "nodemon -w '../../*.cjs' -e cjs --exec 'webpack-dev-server' -- --config webpack.build-dev.cjs",
    "build-game-prod": "webpack --config webpack.build-dist.cjs",
    "dev2": "npm-run-all --parallel dev-start2 dev2-pack",
    "dev2-pack": "webpack-dev-server --open --config webpack.engine.cjs --history-api-fallback --inline --progress",
    "build2": "webpack --config webpack.engine.cjs",
    "postinstall": "echo \"Thanks for installing ReMake Engine...\""
  },
  "engines": {
    "node": "16.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://mstein77@github.com/mstein77/2DFireEngine.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mstein77/2DFireEngine/issues"
  },
  "bin": {
    "remake-engine-cli": "bin/remake.js"
  },
  "homepage": "https://github.com/mstein77/2DFireEngine#readme",
  "dependencies": {
    "express": "^4.17.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.10",
    "@babel/core": "^7.18.10",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-react": "^7.0.0",
    "@statoscope/webpack-plugin": "^5.24.0",
    "babel-loader": "^8.0.6",
    "body-parser": "^1.20.0",
    "chai": "^4.2.0",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "cors": "^2.8.5",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^4.0.0",
    "dotenv": "^16.0.1",
    "eslint-webpack-plugin": "^3.2.0",
    "file-loader": "^6.2.0",
    "gl-matrix": "^3.3.0",
    "glob": "^8.0.3",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.0.3",
    "jsdoc": "^3.6.6",
    "mini-css-extract-plugin": "^2.6.1",
    "mocha": "^10.0.0",
    "nodemon": "^2.0.4",
    "npm-run-all": "^4.1.5",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.3",
    "webpack": "^5.73.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.10.1",
    "webpack-merge": "^4.2.2"
  }
}
