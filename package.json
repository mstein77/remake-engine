{
  "name": "2dfireengine",
  "version": "1.0.0",
  "description": "2D Game Engine",
  "main": "public/index.html",
  "scripts": {
    "babel": "babel --presets es2015 js/main.js -o build/main.bundle.js",
    "start": "node server.js",
    "dev-start": "nodemon server.js",
    "dev-server": "webpack-dev-server --open --config webpack.dev.js --history-api-fallback --inline --progress",
    "dev": "npm-run-all --parallel dev-server dev-start",
    "build": "webpack --config webpack.dev.js",
    "test": "mocha",
    "dev2": "npm-run-all --parallel dev-start dev2-pack",
    "dev2-pack": "webpack-dev-server --open --config webpack.engine.js --history-api-fallback --inline --progress ",
    "build2": "webpack --config webpack.engine.js"
  },
  "engines": {
    "node": "12.13.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://mstein77@github.com/mstein77/2DFireEngine.git"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mstein77/2DFireEngine/issues"
  },
  "bin": {
    "remake-cli": "bin/remake.js"
  },
  "homepage": "https://github.com/mstein77/2DFireEngine#readme",
  "devDependencies": {
    "@babel/cli": "^7.18.10",
    "@babel/core": "^7.18.10",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-react": "^7.0.0",
    "@statoscope/webpack-plugin": "^5.24.0",
    "babel-loader": "^8.0.6",
    "chai": "^4.2.0",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^5.1.1",
    "css-loader": "^1.0.0",
    "css-minimizer-webpack-plugin": "^4.0.0",
    "glob": "^8.0.3",
    "html-webpack-plugin": "^5.5.0",
    "jsdoc": "^3.6.6",
    "mini-css-extract-plugin": "^2.6.1",
    "mocha": "^8.2.1",
    "nodemon": "^2.0.4",
    "npm-run-all": "^4.1.5",
    "style-loader": "^0.23.0",
    "terser-webpack-plugin": "^5.3.3",
    "webpack": "^5.73.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^3.3.6",
    "webpack-dev-server": "^3.7.2",
    "webpack-merge": "^4.2.2"
